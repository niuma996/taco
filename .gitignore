# Dependencies
node_modules/
.pnpm-store/

# Build output — per-package scripts that emit artifacts
**/dist/
packages/sidecar/lib/
packages/sidecar/dist/

# Desktop / Tauri build artifacts
clients/*/dist/
clients/*/src-tauri/target/
clients/*/src-tauri/binaries/
clients/*/src-tauri/generated/
clients/*/src-tauri/gen/

# Bundler / framework caches
.turbo/
.vite/
.cache/

# Tooling caches
.claude/
.superpowers/
docs/superpowers/
.worktrees/
.release-staging/

# Test / coverage output
coverage/

# Local environment overrides
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (unused, but cheap to keep in a Node repo that may pull notebooks)
__pycache__/

# Agent/AI instruction files (local-only, not shared via git)
AGENTS.md
CLAUDE.md
DESIGN.md
docs/plans/
docs/local/

# Tauri updater signing keys (PR5 / docs/signing.md). The keypair is
# generated locally by the operator and never committed — only the
# base64 public key string is embedded into tauri.conf.json by hand.
# These patterns ignore the operator-local keypair files.
*.minisign
taco-update.key
taco-update.pub