{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "files": [],
  "references": [
    { "path": "./packages/cli/tsconfig.json" },
    { "path": "./packages/protocol/tsconfig.json" },
    { "path": "./packages/shared/tsconfig.json" },
    { "path": "./packages/sidecar/tsconfig.json" },
    { "path": "./packages/sidecar/tsconfig.test.json" },
    { "path": "./clients/debug-console/tsconfig.json" },
    { "path": "./clients/taco-desktop/tsconfig.json" },
    { "path": "./clients/taco-desktop/tsconfig.test.json" }
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
