{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/tests/**/*.ts",
    "clients/**/src/**/*.{ts,tsx}",
    "clients/**/tests/**/*.{ts,tsx}"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
