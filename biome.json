{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "indentStyle": "space",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "noUnusedTemplateLiteral": "error",
        "useTemplate": "off",
        "useImportType": "error",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noAssignInExpressions": "error",
        "noTemplateCurlyInString": "off",
        "noArrayIndexKey": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noUnsafeOptionalChaining": "off"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noImportantStyles": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useButtonType": "off",
        "noStaticElementInteractions": "off",
        "useFocusableInteractive": "off",
        "useAriaPropsSupportedByRole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/sidecar/src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "packages/sidecar/src/**",
        "packages/sidecar/tests/**",
        "!packages/sidecar/src/runtime/pi/**",
        "!packages/sidecar/src/lib/harnessContext.ts",
        "!packages/sidecar/src/runtime/harnessErrors.ts",
        "!packages/sidecar/src/runtime/modelRegistry.ts",
        "!packages/sidecar/src/runtime/customProvider.ts",
        "!packages/sidecar/tests/runtime/attachedSession.streaming.test.ts",
        "!packages/sidecar/tests/runtime/imToolFilter.test.ts",
        "!packages/sidecar/tests/server/handlers/skills.diagnostics.test.ts",
        "!packages/sidecar/tests/server/handlers/skills.inlineOnly.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@earendil-works/pi-agent-core": "Import pi types from src/runtime/pi/types.ts and pi values from src/runtime/pi/values.ts. ACL wrappers (lib/harnessContext.ts, runtime/harnessErrors.ts) and the provider/lazy fan-out (runtime/modelRegistry.ts, runtime/customProvider.ts) are exempted via this override's includes list.",
                  "@earendil-works/pi-agent-core/node": "Import from src/runtime/pi/node.ts instead."
                }
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/target",
      "!**/build",
      "!**/coverage",
      "!**/src-tauri/gen",
      "!**/src-tauri/binaries",
      "!**/src-tauri/generated",
      "!**/packages/sidecar/dist",
      "!**/packages/sidecar/lib",
      "!**/clients/**/dist",
      "!**/.claude/settings.json",
      "!**/.claude/settings.local.json",
      "!**/.superpowers"
    ]
  }
}
