{
  "name": "@taco-ai/sidecar",
  "version": "0.3.4",
  "private": false,
  "description": "Taco sidecar — Pi harness-driven JSON-RPC protocol layer. WeChat IM channel support requires the optional @wechatbot/wechatbot dependency (not bundled by default; see README IM Channels).",
  "type": "module",
  "bin": {
    "taco-sidecar": "./bin/taco-sidecar.cjs"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@wechatbot/wechatbot": "2.2.0",
    "@wecom/aibot-node-sdk": "1.0.7"
  },
  "license": "MIT",
  "repository": "github:niuma996/taco",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "node esbuild.config.mjs",
    "package:runtime": "node scripts/buildRuntime.mjs",
    "package:archive": "node scripts/archiveRuntime.mjs",
    "sync:staging": "node scripts/syncPnpmStaging.mjs",
    "test": "tsx --import ./tests/_helpers/testSetup.ts --test 'tests/**/*.test.ts'",
    "test:prompts": "tsx --import ./tests/_helpers/testSetup.ts --test tests/prompts/prompts.test.ts",
    "test:tags": "tsx --import ./tests/_helpers/testSetup.ts --test tests/tags/tags.core.test.ts",
    "test:reply": "tsx --import ./tests/_helpers/testSetup.ts --test tests/tags/tags.context.test.ts",
    "test:methods": "tsx --import ./tests/_helpers/testSetup.ts --test tests/server/server.methods.test.ts",
    "test:methods:snapshot": "tsx --import ./tests/_helpers/testSetup.ts --test tests/server/server.methods.test.ts",
    "test:agents": "tsx --import ./tests/_helpers/testSetup.ts --test tests/server/handlers/handlers.agents.test.ts",
    "test:extensionsStatus": "tsx --import ./tests/_helpers/testSetup.ts --test tests/server/server.methods.test.ts",
    "test:logger": "tsx --import ./tests/_helpers/testSetup.ts --test tests/lib/lib.test.ts",
    "test:stderrTee": "tsx --import ./tests/_helpers/testSetup.ts --test tests/lib/lib.test.ts",
    "test:tools": "tsx --import ./tests/_helpers/testSetup.ts --test tests/tools/tools.builtin.test.ts",
    "test:extensions": "tsx --import ./tests/_helpers/testSetup.ts --test tests/extensions/extensions.test.ts tests/extensions/extensions.activation.test.ts tests/runtime/workspace.core.test.ts",
    "test:config": "tsx --import ./tests/_helpers/testSetup.ts --test 'tests/config/*.test.ts'",
    "test:skills": "tsx --import ./tests/_helpers/testSetup.ts --test 'tests/skills/*.test.ts'",
    "test:smoke": "tsx --import ./tests/_helpers/testSetup.ts --test tests/packaging/shellParserAssets.test.ts",
    "test:memory": "tsx --import ./tests/_helpers/testSetup.ts --test tests/memory/memory.test.ts tests/server/handlers/handlers.workspace.test.ts tests/runtime/attachedSession.state.test.ts tests/tools/tools.builtin.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@taco-ai/pi-harness": "0.1.0",
    "@taco-ai/protocol": "workspace:*",
    "@taco-ai/shared": "workspace:*",
    "chokidar": "4.0.3",
    "croner": "^9.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.14",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "typebox": "^1.4.3",
    "unpdf": "1.9.1",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
