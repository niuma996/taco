{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Taco default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "core:event:default",
    "core:window:allow-start-dragging"
  ]
}
