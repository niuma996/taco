{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taco",
  "version": "0.1.0",
  "identifier": "com.taco.desktop",
  "build": {
    "beforeDevCommand": "node scripts/stageSidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/stageSidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Taco",
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Taco 桌面客户端 — 通过 NDJSON sidecar 调用 taco runtime",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/taco-sidecar-node"],
    "resources": {
      "generated/sidecar/lib/index.mjs": "sidecar/lib/index.mjs",
      "generated/sidecar/agents": "sidecar/agents",
      "generated/sidecar/skills": "sidecar/skills",
      "generated/sidecar/manifest.json": "sidecar/manifest.json"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
