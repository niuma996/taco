{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taco",
  "version": "0.1.0",
  "identifier": "com.taco.desktop",
  "build": {
    "beforeDevCommand": "node scripts/stageSidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/stageSidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/niuma996/taco/releases/latest/download/update.json"],
      "pubkey": "PLACEHOLDER_REPLACE_WITH_MINISIGN_PUBKEY_BASE64_SEE_DOCS_SIGNING_MD",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Taco \u684c\u9762\u5ba2\u6237\u7aef \u2014 \u901a\u8fc7 NDJSON sidecar \u8c03\u7528 taco runtime",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/taco-sidecar-node"],
    "resources": {
      "generated/sidecar/lib/index.mjs": "sidecar/lib/index.mjs",
      "generated/sidecar/agents": "sidecar/agents",
      "generated/sidecar/skills": "sidecar/skills",
      "generated/sidecar/manifest.json": "sidecar/manifest.json",
      "generated/cli/taco.mjs": "cli/taco.mjs"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
