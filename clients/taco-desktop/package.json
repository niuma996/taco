{
  "name": "@taco-ai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Taco 桌面客户端 — Tauri + React + Vite,通过 NDJSON sidecar 协议调用 taco runtime",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:all": "pnpm test && pnpm test:files && pnpm test:memory",
    "test:utils": "tsx --test tests/lib/chatUtils.test.ts",
    "test:markdown": "tsx --test tests/lib/markdownHelpers.test.ts",
    "test:events": "tsx --test tests/lib/sessionCursor.test.ts tests/lib/sessionPushProcessor.test.ts tests/lib/applyEventToMessages.test.ts",
    "test:theme": "tsx --test tests/lib/theme.test.ts tests/lib/clientSettings.test.ts",
    "test:logline": "tsx --test tests/lib/sidecarLogLine.test.ts",
    "test:reducer": "tsx --test tests/lib/workspaceReducer.test.ts",
    "test:files": "vitest run tests/hooks/useFileTree.test.tsx tests/hooks/useFilePreview.test.tsx tests/components/FilesDrawer.test.tsx",
    "test:memory": "vitest run tests/components/MemoryPane.test.tsx"
  },
  "license": "MIT",
  "repository": "github:niuma996/taco",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@shikijs/rehype": "^4.4.1",
    "@taco-ai/protocol": "workspace:*",
    "@taco-ai/shared": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
