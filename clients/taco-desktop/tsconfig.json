{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "paths": {
      "@taco-ai/shared": ["../../packages/shared/tacoClient.ts"],
      "@taco-ai/protocol": ["../../packages/protocol/src/index.ts"],
      "@taco-ai/protocol/*": ["../../packages/protocol/src/*"]
    }
  },
  "include": ["src", "../../packages/shared/tacoClient.ts"]
}
